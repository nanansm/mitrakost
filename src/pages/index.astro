---
import Base from '../layouts/Base.astro';
import { getRooms, rupiah } from '../lib/rooms';
import {
  site,
  waLink,
  hero,
  tipeKamar,
  lokasi,
  fasilitas,
  caraSewa,
  faq,
  penutup,
} from '../data/content';

const { rooms, sumber } = await getRooms();
if (sumber === 'snapshot') {
  console.warn('[build] Ketersediaan dari snapshot repo. Set SHEET_CSV_URL supaya ikut Google Sheet.');
}
const kosong = rooms.filter((r) => r.status === 'kosong');

const perLokasi = lokasi.map((l) => ({
  ...l,
  kosong: kosong.filter((r) => l.nama.includes(r.lokasi)).length,
}));

const diperbarui = new Date().toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Jakarta',
});

const pesanKamar = (r: { tipe: string; nomor: string; lokasi: string }) =>
  waLink(`Halo admin, kamar ${r.tipe} nomor ${r.nomor} di ${r.lokasi} masih kosong?`);
---

<Base
  judul="Mitra Kost Sumedang | Kos Bulanan 1 Menit dari Alun-Alun"
  deskripsi={hero.sub}
  heroImg={hero.gambar}
>
  {/* ── Hero ─────────────────────────────────────────── */}
  <section class="relative isolate overflow-hidden">
    <img
      src={hero.gambar}
      alt={hero.gambarAlt}
      width="1600"
      height="900"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-ink/85 via-ink/70 to-brand-900/70"></div>

    <div class="mx-auto max-w-6xl px-4 pb-16 pt-20 sm:px-6 sm:pb-20 sm:pt-28">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-200">
        Sumedang &middot; {site.totalKamar} kamar &middot; 2 lokasi
      </p>

      <h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-[1.08] text-white sm:text-5xl lg:text-6xl">
        {hero.h1}
      </h1>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-slate-200 sm:text-lg">
        {hero.sub}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={waLink('Halo admin Mitra Kost, saya mau tanya kamar kosong.')}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-12 items-center rounded-full bg-brand-600 px-6 text-sm font-semibold text-white shadow-lg shadow-brand-900/30 transition hover:bg-brand-700 sm:text-base"
        >
          {hero.cta}
        </a>
        <a
          href="#kosong"
          class="inline-flex min-h-12 items-center rounded-full border border-white/30 px-6 text-sm font-semibold text-white transition hover:bg-white/10 sm:text-base"
        >
          Lihat daftar kamar
        </a>
      </div>

      <div
        class="mt-10 inline-flex flex-wrap items-center gap-x-3 gap-y-1 rounded-2xl bg-white/10 px-4 py-3 text-sm text-white ring-1 ring-white/15 backdrop-blur"
      >
        <span class="relative flex h-2.5 w-2.5">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-300 opacity-75"
          ></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-brand-500"></span>
        </span>
        <strong class="font-semibold">{kosong.length} kamar kosong</strong>
        <span class="text-slate-300">dari {site.totalKamar}</span>
        <span class="text-slate-400">&middot; diperbarui {diperbarui}</span>
      </div>
    </div>
  </section>

  {/* ── Kamar kosong ─────────────────────────────────── */}
  <section id="kosong" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
      {kosong.length > 0 ? `${kosong.length} Kamar Kosong Hari Ini` : 'Semua Kamar Sedang Terisi'}
    </h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      {
        kosong.length > 0
          ? 'Daftar ini ikut isian admin. Kamar yang sudah terisi hilang dari daftar begitu admin menandainya, jadi yang kamu lihat di sini memang yang masih bisa ditempati.'
          : 'Chat admin buat masuk daftar tunggu. Kamar biasanya lepas di akhir bulan.'
      }
    </p>

    {
      kosong.length > 0 && (
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {kosong.map((r) => (
            <li class="group rounded-2xl border border-line bg-white p-5 transition hover:border-brand-200 hover:shadow-md">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-lg font-bold">
                    {r.tipe} <span class="text-ink-soft">{r.nomor}</span>
                  </p>
                  <p class="mt-0.5 text-sm text-ink-soft">{r.lokasi}</p>
                </div>
                <span class="shrink-0 rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700">
                  Kosong
                </span>
              </div>

              <p class="mt-4 text-xl font-extrabold text-brand-600">
                {rupiah(r.harga_1_orang)}
                <span class="text-sm font-medium text-ink-soft"> / bulan</span>
              </p>
              <p class="text-sm text-ink-soft">Berdua {rupiah(r.harga_2_orang)} per bulan</p>

              <a
                href={pesanKamar(r)}
                target="_blank"
                rel="noopener"
                class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-ink px-4 text-sm font-semibold text-white transition group-hover:bg-brand-600"
              >
                Tanya kamar ini
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        perLokasi.map((l) => (
          <p class="rounded-xl bg-slate-50 px-4 py-3 text-sm text-ink-soft">
            <strong class="font-semibold text-ink">{l.nama}</strong> {l.kosong} kosong dari {l.jumlah} kamar
          </p>
        ))
      }
    </div>
  </section>

  {/* ── Tipe & harga ─────────────────────────────────── */}
  <section id="tipe" class="scroll-mt-20 border-y border-line bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
        Empat Tipe, Harga Mulai Rp800 Ribu
      </h2>
      <p class="mt-3 text-ink-soft">Harga per bulan. Angka kedua untuk yang berdua.</p>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          tipeKamar.map((t) => (
            <article class="flex flex-col overflow-hidden rounded-2xl border border-line bg-white">
              <img
                src={t.foto}
                alt={`Kamar tipe ${t.nama}`}
                width="600"
                height="450"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover"
              />
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-lg font-bold">{t.nama}</h3>
                <p class="mt-1 text-2xl font-extrabold text-brand-600">
                  {rupiah(t.harga1)}
                  <span class="text-sm font-medium text-ink-soft"> / bln</span>
                </p>
                <p class="text-sm text-ink-soft">Berdua {rupiah(t.harga2)}</p>

                <ul class="mt-4 flex-1 space-y-1.5 text-sm text-ink-soft">
                  {t.isi.map((i) => (
                    <li class="flex gap-2">
                      <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" />
                      {i}
                    </li>
                  ))}
                  {t.tanpa.map((i) => (
                    <li class="flex gap-2 text-slate-400 line-through">
                      <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-slate-300" />
                      {i}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <p class="mt-6 text-sm text-ink-soft">Semua tipe sudah termasuk WiFi, CCTV, dan parkir.</p>
    </div>
  </section>

  {/* ── Lokasi ───────────────────────────────────────── */}
  <section id="lokasi" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
      Budi Asih 41 Kamar, Jatihurip 16 Kamar
    </h2>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        lokasi.map((l) => (
          <article class="overflow-hidden rounded-2xl border border-line">
            <iframe
              src={l.maps}
              title={`Peta ${l.nama}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="aspect-[16/10] w-full border-0"
            />
            <div class="p-5">
              <h3 class="text-lg font-bold">{l.nama}</h3>
              <p class="mt-0.5 text-sm text-ink-soft">
                {l.ringkas} &middot; {l.jumlah} kamar
              </p>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{l.keterangan}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* ── Fasilitas ────────────────────────────────────── */}
  <section class="border-y border-line bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
        Yang Kamu Dapat Tanpa Biaya Tambahan
      </h2>

      <dl class="mt-8 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          fasilitas.map((f) => (
            <div class="border-t border-line pt-4">
              <dt class="font-semibold">{f.label}</dt>
              <dd class="mt-0.5 text-sm text-ink-soft">{f.catatan}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ── Cara sewa ────────────────────────────────────── */}
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Dari Chat Sampai Pegang Kunci</h2>

    <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        caraSewa.map((s, i) => (
          <li>
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
              {i + 1}
            </span>
            <h3 class="mt-3 font-bold">{s.judul}</h3>
            <p class="mt-1 text-sm leading-relaxed text-ink-soft">{s.isi}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── FAQ ──────────────────────────────────────────── */}
  <section id="tanya" class="scroll-mt-20 border-t border-line bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Yang Paling Sering Ditanya</h2>

      <div class="mt-8 divide-y divide-line border-y border-line">
        {
          faq.map((f) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
                {f.t}
                <span class="shrink-0 text-brand-600 transition group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{f.j}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Penutup ──────────────────────────────────────── */}
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="rounded-3xl bg-ink px-6 py-12 text-center sm:px-12 sm:py-16">
      <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-4xl">{penutup.judul}</h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-slate-300">{penutup.isi}</p>

      <a
        href={waLink('Halo admin Mitra Kost, saya mau tanya kamar kosong.')}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-flex min-h-12 items-center rounded-full bg-brand-600 px-7 font-semibold text-white transition hover:bg-brand-700"
      >
        Chat Admin di WhatsApp
      </a>

      <p class="mt-4 text-sm text-slate-400">{site.waTampil}</p>
      <p class="mx-auto mt-8 max-w-md text-xs leading-relaxed text-slate-500">{penutup.finePrint}</p>
    </div>
  </section>

</Base>
